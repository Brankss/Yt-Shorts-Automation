# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Credentials — never commit these.
# The youtube-* skills store OAuth material in ~/.config/youtube-skills/,
# outside the repo. These patterns are defensive, in case a file is ever
# copied in here by mistake.
client_secret*.json
token.json
token_write.json
channel_write.json
pending_auth.json
.env
.env.*

# Skill output / working data
# The youtube-* skills write fetched channel data and generated reports here.
# Regenerable from the APIs, and a moving target — keep it out of history.
reports/
*.local.json

# Rendered videos — large, reproducible from the episode file plus the DNA.
out/

# HyperFrames project working files.
# vendor/ is deliberately NOT ignored: gsap is committed so renders do not
# depend on a network fetch, which the determinism rules forbid anyway.
node_modules/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/renders/

# Owner-supplied source audio. Kept out of git: large, and the music is a
# commercial track whose licence is the channel owner's to manage, not this
# repository's to redistribute. The trimmed derivatives under assets/ are what
# the composition uses.
videos/*/assets/source/
